# ── Documents commerciaux : jamais dans le dépôt ──────────────
# Proposition, devis, tarification (prix plancher, marge de négociation),
# scripts oraux, mails, support de présentation et son outillage
# (pptxgenjs). Ils portent des montants et des coordonnées nominatives.
prospection/
# Filet de sécurité : un PDF ou un support régénéré par erreur à la racine.
/*.pdf
/*.pptx
/*.docx

# ── Archives locales ──────────────────────────────────────────
# Remises de design (motion, motifs pagne), captures du site d'origine,
# relevés d'audit, variante d'accueil non retenue. Gardés pour mémoire.
archives/

# ── Secrets locaux ────────────────────────────────────────────
# .env.local porte ADMIN_MDP. Il ne doit JAMAIS partir dans le dépôt : un mot
# de passe poussé sur un dépôt distant est à considérer comme divulgué, même
# si on l'efface ensuite.
.env.local
.env

# ── Photos sources ────────────────────────────────────────────
# Les originaux téléchargés depuis evannathhotel.com (~60 Mo de PNG).
# Seules les versions optimisées de site/img/opt/ sont servies et versionnées.
# Pour les régénérer : voir la section « Régénérer les images » du README.
site/img/gallery/
site/img/rest/
site/img/rooms/
site/img/brand/
site/img/insta/
site/img/manquant/
site/img/fb/

# ── Images écartées ───────────────────────────────────────────
# Fichiers devenus orphelins, déplacés plutôt que supprimés : une fois déjà,
# des variantes dont le chemin était construit en JavaScript ont failli être
# effacées. Voir « Photos mal nommées » dans le README.
site/.quarantaine/
site/*.gardefou
site/index-luxe-variante.html

# ── Dépendances ───────────────────────────────────────────────
# site/package.json EST versionné : Vercel y lit les dépendances des
# fonctions serverless. Le dossier node_modules, lui, se réinstalle.
node_modules/

# ── Captures de travail ───────────────────────────────────────
# Produites par .outils/capturer.js ; elles se refont d'une commande.
apercu-*.png
maquette-*.png
vue-*.png
bo-*.png
verif-*.png

# ── Environnement local et outils IA ──────────────────────────
.claude/
.agents/
skills-lock.json
__pycache__/
*.pyc
Thumbs.db
desktop.ini
.DS_Store
